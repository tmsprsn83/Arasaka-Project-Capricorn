# Réglages de CAPRI sur le VPS : copier en `serveur/.env` (droits 600), remplir, ne jamais commiter ni copier ailleurs.
# Jetons : générer chacun avec `openssl rand -hex 32`.

# --- Centrale ---
ANTHROPIC_API_KEY=
# Jeton du PC de Tommy (le même dans centrale.json sur le PC).
CAPRI_JETON=
# Jeton entre la centrale et le module de communication (reste sur le serveur).
CAPRI_JETON_INTERNE=
# Facultatif : modèle et effort (par défaut claude-opus-5-5, low), dossier des données.
# CAPRI_MODELE=claude-opus-5-5
# CAPRI_EFFORT=low
# CAPRI_DONNEES=/opt/capri/donnees
CAPRI_URL_COMMUNICATION=http://127.0.0.1:8711
TZ=Europe/Paris

# --- Communication (téléphone, Twilio) ---
# Adresse publique HTTPS que Twilio appelle (celle de Caddy), sans / final.
CAPRI_URL_PUBLIQUE=https://capri.exemple.fr
# Numéros au format international.
CAPRI_NUMERO_TOMMY=+336XXXXXXXX
TWILIO_NUMERO=+33XXXXXXXXX
TWILIO_ACCOUNT_SID=
# Jeton principal du compte : sert à vérifier la signature des webhooks.
TWILIO_AUTH_TOKEN=
# Clé d'API (Account → API keys) pour envoyer SMS et appels : SID « SK… » et son secret.
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Facultatif : voix française de synthèse de Twilio.
# CAPRI_VOIX=Polly.Lea-Neural
